# Copiar a .env y completar. El archivo .env NUNCA se sube a git.

# --- PostgreSQL ---
PGUSER=odoo
PGPASSWORD=

# --- Odoo ---
# Contrasena maestra del gestor de bases de datos (/web/database/manager)
ODOO_ADMIN_PASSWD=

# Imagen a ejecutar (local: siteco/odoo:20.0 ; produccion: ghcr.io/<org>/<repo>:<tag>)
ODOO_IMAGE=siteco/odoo:20.0

ODOO_HTTP_PORT=8069
ODOO_GEVENT_PORT=8072

# --- Produccion (detras de proxy inverso con TLS) ---
# ODOO_PROXY_MODE=true
# ODOO_LIST_DB=false
# Una base por subdominio: cliente1.midominio.com -> base "cliente1"
# ODOO_DBFILTER=^%d$
# Regla: workers = (nucleos * 2) + 1 ; con workers > 0 el websocket va por el puerto 8072
# ODOO_WORKERS=5
# ODOO_MAX_CRON_THREADS=2
